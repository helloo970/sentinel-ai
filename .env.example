# Copy this file to .env (repository root) and fill in the values locally.
# Never commit .env. All SENTINEL_* values are optional.

# --- Claude API -----------------------------------------------------------------
ANTHROPIC_API_KEY=
SENTINEL_LLM_MODEL=claude-opus-5-5
# Google Gemini instead of Claude: better store the key with "sentinel gemini login"
# (Windows Credential Manager). Used only when ANTHROPIC_API_KEY is empty.
# GEMINI_API_KEY=
SENTINEL_GEMINI_MODEL=gemini-flash-latest
# OpenRouter (preferred over Gemini): store the key with "sentinel openrouter login"
# OPENROUTER_API_KEY=
SENTINEL_OPENROUTER_MODEL=anthropic/claude-opus-5.5
# Reasoning before answering: more careful, but much slower
SENTINEL_OPENROUTER_REASONING=false
# low | medium | high (low keeps chat fast and cheap)
SENTINEL_LLM_EFFORT=low
SENTINEL_BUDGET_DAILY_EUR=2.0
SENTINEL_BUDGET_MONTHLY_EUR=30.0

# --- General --------------------------------------------------------------------
# Your name for Jarvis (empty: he calls you "Sir")
SENTINEL_USER_NAME=
SENTINEL_LOG_LEVEL=INFO
# 0 observer, 1 assistant, 2 autopilot, 3 guardian
SENTINEL_AUTONOMY_DEFAULT=2
# Data directory (default: %LOCALAPPDATA%\SentinelAI)
# SENTINEL_DATA_DIR=

# --- Folders (JSON lists, use forward slashes) ----------------------------------
# Folders where quarantine, organizing and recycle bin are allowed
# SENTINEL_MANAGED_FOLDERS=["C:/Users/<you>/Downloads"]
# Folders watched for risky files and mass changes
# SENTINEL_WATCHED_FOLDERS=["C:/Users/<you>/Downloads","C:/Users/<you>/Documents"]

# --- Home network (RFC 1918 only, /22 or smaller) -------------------------------
# Auto-detected when empty
# SENTINEL_HOME_SUBNET=192.168.1.0/24

# --- Push notifications via self-hosted ntfy (must be in the home network) ------
# SENTINEL_NTFY_URL=http://10.0.0.5:8080
# SENTINEL_NTFY_TOPIC=sentinel
# SENTINEL_NTFY_TOKEN=

# --- Ubuntu server agent (see server-agent/README.md) ---------------------------
# SENTINEL_SERVER_AGENT_URL=https://10.0.0.5:8844
# SENTINEL_SERVER_AGENT_TOKEN=
# SENTINEL_SERVER_AGENT_CA=C:/Users/<you>/AppData/Local/SentinelAI/config/server-cert.pem
# Push the status to the agent for the phone view (emergency stop from the phone)
SENTINEL_SERVER_RELAY=true
# Warn when the newest file in a server backup folder is older than this (hours)
SENTINEL_BACKUP_MAX_AGE_H=26

# --- Voice (pip install -e ".[voice]" + scripts/download-voice-models.ps1) ------
SENTINEL_VOICE_ENABLED=false
SENTINEL_VOICE_WAKEWORD=true
SENTINEL_VOICE_CLAP=true
SENTINEL_WHISPER_MODEL=small
# SENTINEL_PIPER_VOICE=C:/Users/<you>/AppData/Local/SentinelAI/voices/en_US-lessac-medium.onnx

# --- Weather, Gmail, daily report --------------------------------------------
# Your town for the weather (Open-Meteo, no account) - or set lat/lon directly
# SENTINEL_HOME_CITY=Berlin
# SENTINEL_HOME_LAT=52.52
# SENTINEL_HOME_LON=13.40
# Gmail: run 'sentinel gmail login' once (app password goes to Windows Credential
# Manager, never into this file)
SENTINEL_EVENING_REPORT_TIME=21:00
# Keep listening this many seconds after an answer (conversation mode)
SENTINEL_VOICE_FOLLOWUP_S=30
# Extra TLS certificates to watch (host:port, home network only), JSON list
# SENTINEL_CERT_WATCH=["192.168.1.10:8443"]
# Weekly cleanup of the managed folders (0 = Monday ... 6 = Sunday), undo stays a week
SENTINEL_DOWNLOADS_CLEANUP=true
SENTINEL_DOWNLOADS_CLEANUP_DAY=6
SENTINEL_DOWNLOADS_CLEANUP_TIME=10:00

# --- Agents ---------------------------------------------------------------------
# Run the security analyst every N hours (0 = only on demand)
SENTINEL_AGENTS_SCHEDULE_HOURS=0

# --- Semantic memory (optional, pip install -e ".[embeddings]") -----------------
# SENTINEL_EMBEDDINGS=fastembed

# Brain (3D knowledge graph)
# Folders to ingest (JSON list); default: Documents, Desktop, SentinelAI
# SENTINEL_BRAIN_FOLDERS=["C:/Users/<you>/Documents"]
# AI requests per day for sorting things into the graph (0 = off)
# SENTINEL_BRAIN_AI_DAILY=15
# Minutes without conversation before it starts learning
# SENTINEL_BRAIN_IDLE_MIN=5
# Backup on the server every n hours (0 = off); password: sentinel brain password
# SENTINEL_BRAIN_BACKUP_HOURS=24

# Speech recognition: elevenlabs (Scribe, online, accurate) or local (Whisper on the PC)
# SENTINEL_STT_ENGINE=elevenlabs

# Open web pages in the app window instead of the default browser
# SENTINEL_WEB_IN_APP=true

# AI only in conversation: world situation, briefing, brain learning and agent schedule
# without a language model
# SENTINEL_AI_ONLY_IN_CHAT=true

# Quiet hours: no spoken announcements and no greeting (except critical alerts).
# Can also be changed in the app under Settings -> Setup.
# SENTINEL_QUIET_HOURS=23:00-07:00
# Malware list (abuse.ch): free Auth key only via `sentinel abusech login`
# (it ends up in the Windows Credential Manager, never here).
# Database: daily backup in <data folder>/backup/auto (7 kept),
# restore with `sentinel db restore` (quit the app first).

# Live camera video: path to ffmpeg.exe (empty = PATH or `winget install Gyan.FFmpeg`).
# Camera login only via `sentinel camera login` (Windows Credential Manager).
# SENTINEL_FFMPEG_PATH=
